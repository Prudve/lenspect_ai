{
  "expo": {
    "name": "LMPC Field Inspector",
    "slug": "lmpc-compliance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LMPC Inspector requires camera access to capture packaging labels and reference scaling cards.",
        "NSLocationWhenInUseUsageDescription": "LMPC Inspector attaches precise GPS coordinates to each inspection for statutory compliance records."
      }
    },
    "android": {
      "package": "com.lmpc.inspector",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan package labels and reference cards."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to attach geotag metadata to inspection records."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5c1ae1d4-0da1-4725-98a1-405f3a79c9ba"
      }
    }
  }
}
